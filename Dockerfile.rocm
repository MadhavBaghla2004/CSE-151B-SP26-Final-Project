# AMD ROCm version — use this instead of Dockerfile if you have an AMD GPU
FROM rocm/vllm-dev:latest

WORKDIR /workspace

RUN apt-get update && apt-get install -y git wget curl && \
    rm -rf /var/lib/apt/lists/*

# Install dependencies (no bitsandbytes — not supported on AMD)
RUN pip install --no-cache-dir \
    sympy numpy transformers tqdm \
    "antlr4-python3-runtime==4.11.1" \
    ipykernel jupyter

RUN python -m ipykernel install --sys-prefix --name cse151b --display-name "Python (cse151b)"

COPY . .

EXPOSE 8888

CMD ["jupyter", "notebook", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token=''"]
